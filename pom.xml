<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The platform's event bus client: publish an event to qits-events, listen for events from
         it. `QitsEvent`, `QitsEventBus`, `QitsEventListener`, `QitsRawEventListener` and
         `CausationScope` are the whole public surface; the outbox, the canonical-JSON serializer
         and the websocket subscriber are how they are kept.

         ONE MODULE AT THE ROOT — no `service/` split, because there is no deployable here. This
         repo produces one jar and nothing else, so this pom is the parent and the module at once:
         the versions a standalone build needs sit beside the dependencies they govern rather than
         in a parent that would exist only to hold them.

         Those versions are duplicated out of the rest of the platform on purpose, for the reason
         qits-ci's own pom gives: A CLONE OF THIS REPO ALONE MUST BUILD, with no monorepo, no
         parent to inherit from, and no prior `mvn install` anywhere. `./mvnw verify` is the gate,
         and the suite is self-contained enough to meet it — the stub qits-events is a JDK
         `HttpServer` the tests start themselves, and the outbox runs on a postgres the suite spawns
         itself from Maven artifacts (zonky), never a container.

         Trimmed to what one library module actually needs. The monorepo's app-wide machinery is
         intentionally absent (spotless, enforcer, surefire chunking, the build-cache extension),
         and so is `quarkus-maven-plugin`: nothing here is packaged as an application, and
         `quarkus-junit5` augments from the classpath at test time without it. -->
    <groupId>eu.wohlben.qits</groupId>
    <artifactId>qits-eventstream</artifactId>
    <version>2026.830.125350</version>
    <packaging>jar</packaging>
    <name>qits-eventstream</name>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.version>3.34.6</quarkus.platform.version>

        <!-- Embedded PostgreSQL for the suite. The outbox's store IS postgres now, so every test
             that boots the persistence unit runs against one — and the first rule here is that a
             clone tests green with NO DOCKER, which rules out Testcontainers and Quarkus dev
             services alike. Zonky resolves real postgres binaries as ordinary Maven artifacts and
             spawns them as a child process: a dependency, not a container.

             Two coordinates, on purpose. The BOM pins which POSTGRES the binaries are (18.4.0 — the
             platform's own postgres tag), the library version is the harness around them, and they
             move independently. Every architecture the suite may run on is named explicitly below:
             the binaries are per-arch artifacts, and a missing one fails in the middle of a suite
             rather than during resolution. -->
        <zonky.embedded-postgres.version>2.2.2</zonky.embedded-postgres.version>
        <zonky.postgres-binaries.version>18.4.0</zonky.postgres-binaries.version>

        <!-- PatientPgDriver, which this jar's shipped datasource defaults NAME. That is what makes
             it a runtime dependency of the library rather than a line in each consumer's pom: a
             default naming a class every consumer must have is only a default if the jar brings the
             class along. Published by libs/qits-integrations-quarkus, which is why the
             <repositories> block below exists — the one dependency here that is neither on Maven
             Central nor part of the Quarkus platform. A clone still tests green with that
             repository reachable, or offline once the jar is in ~/.m2. -->
        <qits.db-core.version>2026.817.175344</qits.db-core.version>
        <qits.maven.repository.url>http://registry.dev.localhost:8080/artifacts/maven/maven</qits.maven.repository.url>

        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <surefire-plugin.version>3.5.4</surefire-plugin.version>
        <jandex-plugin.version>3.4.0</jandex-plugin.version>

        <!-- Surefire's @{argLine} has no value unless something (jacoco/quarkus) sets it. -->
        <argLine/>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <!-- Which postgres the embedded binaries ARE — 18.4.0, the tag the platform's own
                     qits-oci-postgresql image is built from, so the suite proves the lineage
                     against the engine it ships on. Imported as a BOM because the per-arch
                     artifacts below are separate coordinates. -->
                <groupId>io.zonky.test.postgres</groupId>
                <artifactId>embedded-postgres-binaries-bom</artifactId>
                <version>${zonky.postgres-binaries.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.zonky.test</groupId>
                <artifactId>embedded-postgres</artifactId>
                <version>${zonky.embedded-postgres.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <repositories>
        <!-- The platform's own Maven repository, where qits-db-core is published. The id is what a
             locally cached copy is recorded under, so it has to stay `qits-maven` or an offline
             build refuses an artifact it already has. -->
        <repository>
            <id>qits-maven</id>
            <url>${qits.maven.repository.url}</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <!-- The outbox is a Panache entity in this module's OWN named persistence unit; see
                 src/main/resources/META-INF/microprofile-config.properties. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm-panache</artifactId>
        </dependency>
        <dependency>
            <!-- The outbox's store. It was a file H2 until the platform grew resource
                 provisioning; the datasource is now the generic `QITS_RESOURCE_EVENTSTREAM_*`
                 contract, and a consumer's deployment declares `postgresql:eventstream` to have it
                 filled in. See src/main/resources/META-INF/microprofile-config.properties. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
        <dependency>
            <!-- PatientPgDriver: the datasource defaults this jar ships name it, so every consumer
                 needs the class on its runtime classpath and gets it here rather than by
                 remembering a line. RUNTIME scope, not compile, and not optional: nothing in these
                 sources imports it — config carries the name — and an optional dependency is one
                 the consumer has to restate, which is the whole thing this avoids. It is also what
                 keeps the extraction rule true: the class is never named in a source file here.
                 See the datasource block in src/main/resources/META-INF/microprofile-config.properties. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-db-core</artifactId>
            <version>${qits.db-core.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
        </dependency>
        <dependency>
            <!-- Flyway 10 split its database support out of the core: without this module Flyway
                 refuses a postgres url with "no database found to handle". It sits in this jar
                 because this jar owns the lineage — a consumer that did not carry it would fail at
                 boot on a migration it does not own. -->
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <!-- Jackson itself, NOT the CDI ObjectMapper. CanonicalJson builds its own mapper and
                 configures every knob the wire contract depends on, because the canonical form is a
                 thing another service compares byte-for-byte and must not be at the mercy of a
                 consuming application's ObjectMapperCustomizers. The extension is here for the
                 dependency and the native-image registrations, not for the bean. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jackson</artifactId>
        </dependency>
        <dependency>
            <!-- The @Scheduled outbox sweeper. Taken because the retry schedule is the durability
                 guarantee — a failed publish has to be retried with nothing else happening in the
                 process, which is precisely what "sweep when something else comes along" cannot
                 promise. Native-image supported, and it registers no reflection of ours: the
                 scheduled method is a plain package-private method on an @ApplicationScoped bean. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-scheduler</artifactId>
        </dependency>
        <dependency>
            <!-- The CLIENT half — BasicWebSocketConnector, dialling qits-events' /events/stream.
                 The extension ships a server too and this module registers no @WebSocket, so the
                 only cost is in what a consuming deployable already carries.

                 It is the connector rather than vert.x-core's own WebSocketClient (which is what
                 qits-ci-daemon uses, deliberately, to avoid linking an HTTP server into a 45MB
                 static binary) because this jar is only ever consumed by a service that is already
                 serving HTTP, and the connector's callback shape carries the reconnect logic with
                 far less ceremony. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-websockets-next</artifactId>
        </dependency>
        <dependency>
            <!-- The JAX-RS API and nothing more, for the two causation filters. The API jar is
                 what lets them compile here and stay inert elsewhere: a consumer with quarkus-rest
                 or quarkus-rest-client discovers them through the index, a consumer with neither
                 never instantiates them. quarkus-rest itself must NOT sit here — a compile-scope
                 extension would bolt an HTTP server onto every consumer, including the daemons
                 that deliberately serve nothing. -->
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The far end the causation filters need under test: a real resource behind a real
                 HTTP request, because the load-bearing assumption is a THREAD one — RESTEasy
                 Reactive runs filters and a blocking resource method on the same worker — and only
                 the wire can prove it. Test scope for the reason the API jar above is compile
                 scope. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-client</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The store every @QuarkusTest here boots against. Zonky spawns real postgres
                 binaries as a child process — a maven dependency rather than a container — which
                 is what keeps the clone-alone, docker-free rule true now that the outbox's store
                 is postgres. EmbeddedPg + EmbeddedPgConfigSource hand the running instance to
                 Quarkus. -->
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Named per architecture on purpose: the binaries are separate artifacts and zonky
                 picks one at run time, so an unnamed arch fails in the middle of a suite rather
                 than during resolution. These three are what this platform is built and developed
                 on. -->
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-linux-amd64</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-linux-arm64v8</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The musl build, for the platform's own CI: the step container is Alpine, where
                 the glibc binaries above cannot start and the whole suite dies at the config
                 source naming zonky. Found by the first post-receive verify of the postgres-based
                 suite, 2026-08-10. -->
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-linux-amd64-alpine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-darwin-arm64v8</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <!-- The consuming Quarkus app needs an index of this jar's beans and entities —
                     the outbox entity, the sweeper's @Scheduled method and the listener beans are
                     all discovered from it. Without the index the jar is inert on a consumer's
                     classpath and says nothing about why. -->
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
                <version>${jandex-plugin.version}</version>
                <executions>
                    <execution>
                        <id>make-index</id>
                        <goals>
                            <goal>jandex</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
