<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The platform's event bus client: publish an event to qits-events, listen for events from
         it. `QitsEvent`, `QitsEventBus`, `QitsEventListener`, `QitsRawEventListener` and
         `CausationScope` are the whole public surface; the outbox, the canonical-JSON serializer
         and the websocket subscriber are how they are kept.

         ONE MODULE AT THE ROOT — no `service/` split, because there is no deployable here. This
         repo produces one jar and nothing else, so this pom is the parent and the module at once:
         the versions a standalone build needs sit beside the dependencies they govern rather than
         in a parent that would exist only to hold them.

         Those versions are duplicated out of the rest of the platform on purpose, for the reason
         qits-ci's own pom gives: A CLONE OF THIS REPO ALONE MUST BUILD, with no monorepo, no
         parent to inherit from, and no prior `mvn install` anywhere. `./mvnw verify` is the gate,
         and the suite is self-contained enough to meet it — the stub qits-events is a JDK
         `HttpServer` the tests start themselves, and the outbox runs on in-memory H2.

         Trimmed to what one library module actually needs. The monorepo's app-wide machinery is
         intentionally absent (spotless, enforcer, surefire chunking, the build-cache extension),
         and so is `quarkus-maven-plugin`: nothing here is packaged as an application, and
         `quarkus-junit5` augments from the classpath at test time without it. -->
    <groupId>eu.wohlben.qits</groupId>
    <artifactId>qits-eventstream</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>qits-eventstream</name>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.version>3.34.6</quarkus.platform.version>

        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <surefire-plugin.version>3.5.4</surefire-plugin.version>
        <jandex-plugin.version>3.4.0</jandex-plugin.version>

        <!-- Surefire's @{argLine} has no value unless something (jacoco/quarkus) sets it. -->
        <argLine/>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <!-- The outbox is a Panache entity in this module's OWN named persistence unit; see
                 src/main/resources/META-INF/microprofile-config.properties. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm-panache</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-h2</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
        </dependency>
        <dependency>
            <!-- Jackson itself, NOT the CDI ObjectMapper. CanonicalJson builds its own mapper and
                 configures every knob the wire contract depends on, because the canonical form is a
                 thing another service compares byte-for-byte and must not be at the mercy of a
                 consuming application's ObjectMapperCustomizers. The extension is here for the
                 dependency and the native-image registrations, not for the bean. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jackson</artifactId>
        </dependency>
        <dependency>
            <!-- The @Scheduled outbox sweeper. Taken because the retry schedule is the durability
                 guarantee — a failed publish has to be retried with nothing else happening in the
                 process, which is precisely what "sweep when something else comes along" cannot
                 promise. Native-image supported, and it registers no reflection of ours: the
                 scheduled method is a plain package-private method on an @ApplicationScoped bean. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-scheduler</artifactId>
        </dependency>
        <dependency>
            <!-- The CLIENT half — BasicWebSocketConnector, dialling qits-events' /events/stream.
                 The extension ships a server too and this module registers no @WebSocket, so the
                 only cost is in what a consuming deployable already carries.

                 It is the connector rather than vert.x-core's own WebSocketClient (which is what
                 qits-ci-daemon uses, deliberately, to avoid linking an HTTP server into a 45MB
                 static binary) because this jar is only ever consumed by a service that is already
                 serving HTTP, and the connector's callback shape carries the reconnect logic with
                 far less ceremony. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-websockets-next</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <!-- The consuming Quarkus app needs an index of this jar's beans and entities —
                     the outbox entity, the sweeper's @Scheduled method and the listener beans are
                     all discovered from it. Without the index the jar is inert on a consumer's
                     classpath and says nothing about why. -->
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
                <version>${jandex-plugin.version}</version>
                <executions>
                    <execution>
                        <id>make-index</id>
                        <goals>
                            <goal>jandex</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
